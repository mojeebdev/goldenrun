{
  "name": "goldenrun",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "The Golden Run — an unofficial football arcade game. 2008 → 1,000.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run birthday:og && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "cf-typegen": "wrangler types",
    "balance": "tsx scripts/balance.ts",
    "loadcheck": "tsx scripts/loadcheck.ts",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply goldenrun-db --local",
    "birthday:data": "node scripts/birthday/build-data.mjs",
    "birthday:og": "node scripts/birthday/render-og.mjs",
    "birthday:seed:local": "wrangler d1 execute goldenrun-db --local --file data/birthday/seed.sql",
    "birthday:seed:remote": "wrangler d1 execute goldenrun-db --remote --file data/birthday/seed.sql"
  },
  "dependencies": {
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
