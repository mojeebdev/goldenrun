{
  // The Golden Run — one application Worker serving the React/Phaser SPA via
  // Workers Static Assets plus first-party /api/* routes.
  // Milestone 1: NO D1 binding, NO routes/custom domain, NO cron. Nothing here
  // creates remote resources; `wrangler deploy` is an explicit owner action.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldenrun",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
