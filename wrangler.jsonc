{
  // The Golden Run — one application Worker serving the React/Phaser SPA via
  // Workers Static Assets plus first-party /api/* routes, D1 persistence and an
  // hourly cron for weekly cup settlement. Deploying is an explicit owner action.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldenrun",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Needed so the Worker can serve the SPA shell with server-rendered metadata:
    // share previews for /u/* and /c/*, canonical URL + JSON-LD for / and /about.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/u/*", "/c/*", "/", "/about"]
  },
  "routes": [{ "pattern": "goldenrun.fun", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goldenrun-db",
      // Production database (created by the owner in WEUR, 2026-10-29).
      // Local dev and tests use a local SQLite copy and ignore this value.
      "database_id": "acadb1fc-2db5-4563-a1a4-48d211f1cfeb",
      "migrations_dir": "migrations"
    }
  ],
  // Workers Rate Limiting API: counters live in Cloudflare, no resource to create.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": {
    // Hourly, idempotent: opens the current cup week, closes finished weeks,
    // expires abandoned runs and records provisional winners.
    "crons": ["17 * * * *"]
  },
  "vars": {
    "RP_ID": "goldenrun.fun",
    "RP_NAME": "The Golden Run",
    "ALLOWED_ORIGINS": "https://goldenrun.fun"
  },
  "observability": { "enabled": true }
}
